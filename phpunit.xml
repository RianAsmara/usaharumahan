<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Both <env force="true"> and <server>: docker compose's env_file loads
             .env into the app container's real OS environment, which populates
             $_SERVER at process start. PHPUnit's <env> only patches putenv()/$_ENV,
             so without the matching <server> entry Laravel's env() reader (which
             checks $_SERVER) still sees the container's original .env value. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array"/>
        <!-- Real Postgres, not sqlite: the schema uses Postgres check constraints
             and row locking that sqlite cannot exercise. See docs/TESTING.md.
             DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD are deliberately NOT forced
             here: the app's normal DB connection already points at the right
             Postgres server in every environment (docker compose's "postgres"
             host locally, 127.0.0.1 in CI) — only the database name needs to
             change, so the running app's own connection settings are reused. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="usaharumahan_testing" force="true"/>
        <server name="DB_DATABASE" value="usaharumahan_testing"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array"/>
        <!-- Production pins the session cookie to the tenant root domain; the
             test client's default host (localhost) doesn't match that, which
             breaks session/CSRF continuity between requests in feature tests. -->
        <env name="SESSION_DOMAIN" value="null" force="true"/>
        <server name="SESSION_DOMAIN" value="null"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_URL" value="http://localhost"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
