APP_NAME="UsahaRumahan Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://usaharumahan.localhost
APP_DOMAIN=usaharumahan.localhost
TENANT_ROOT_DOMAIN=usaharumahan.localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=usaharumahan
DB_USERNAME=usaharumahan
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Wildcard so it works for every tenant subdomain of TENANT_ROOT_DOMAIN.
SESSION_DOMAIN=.usaharumahan.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=usaharumahan_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@usaharumahan.id"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage. Local development points this at MinIO;
# production points it at a real S3-compatible bucket/region/endpoint.
AWS_ACCESS_KEY_ID=usaharumahan
AWS_SECRET_ACCESS_KEY=secret-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=usaharumahan
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/usaharumahan

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Laravel Socialite) — owner login only.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Payment / shipping adapters. See app/Contracts/Payments and app/Contracts/Shipping.
# "fake" is safe for local dev and CI. Swap to a real provider driver when credentials exist.
PAYMENT_DRIVER=fake
SHIPPING_DRIVER=manual

HORIZON_PREFIX=usaharumahan_horizon:
